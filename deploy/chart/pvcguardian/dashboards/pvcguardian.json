        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "max(pvcguardian_leader)",
          "legendFormat": "Leader",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Leader Election",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Age of the last fully successful reconciliation. Shows Never until the first success; orange after 1 hour, red after 3 hours.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Never",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3600 },
              { "color": "red", "value": 10800 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "time() - max(pvcguardian_last_successful_reconcile_timestamp_seconds) unless max(pvcguardian_last_successful_reconcile_timestamp_seconds) == 0",
          "legendFormat": "Last success",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Last Successful Reconciliation",
      "type": "stat"
    },
